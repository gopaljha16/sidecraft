NEXT_PUBLIC_SITE_URL=https://slidecraft.gopaldev.in

# Keep indexing off until the production domain and launch checks pass.
SITE_INDEXING_ENABLED=false
# For non-Vercel production hosting only; Vercel uses VERCEL_ENV automatically.
DEPLOYMENT_ENV=development
GOOGLE_SITE_VERIFICATION=

# Enable first on a controlled preview for delivery testing. Keep production
# disabled until real inbox delivery and the privacy notice are reviewed.
CONTACT_ENABLED=false
CONTACT_PRIVACY_REVIEWED=false
# Set the actual enquiry-retention policy; no default is assumed.
CONTACT_RETENTION_DAYS=
NEXT_PUBLIC_CONTACT_EMAIL=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=
RESEND_API_KEY=

# Cloudflare Turnstile widget configured for the real site hostname.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Durable spam limits. Never prefix secrets with NEXT_PUBLIC_.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Generate a random value of at least 32 characters; keep it server-side.
CONTACT_RATE_LIMIT_SECRET=

# Optional exact origin for a controlled preview or localhost test.
# Leave empty in the public production project.
CONTACT_PREVIEW_ORIGIN=
